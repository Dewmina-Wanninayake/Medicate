# Copy this to .env and fill in real values before running docker-compose

JWT_SECRET=supersecretkey_change_in_prod

# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Email (Mailtrap recommended for dev — https://mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@healthcare.local

# Twilio (optional — SMS will be console-mocked if blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic Claude API (for AI Symptom Checker — optional enhancement)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Agora — get from https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_EXPIRY=3600
