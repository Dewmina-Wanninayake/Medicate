    {
      "name": "07. Video Sessions (Agora RTC)",
      "item": [
        {
          "name": "Start Session \u2014 Doctor gets Agora token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.channelName) {",
                  "  pm.collectionVariables.set('agoraChannel', res.channelName);",
                  "  pm.collectionVariables.set('agoraAppId', res.appId);",
                  "  console.log('Agora channel:', res.channelName);",
                  "  console.log('Doctor token:', res.token);",
                  "  console.log('Doctor UID:', res.uid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/start/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "start",
                "{{appointmentId}}"
              ]
            },
            "description": "Doctor starts the Agora session. Returns appId, channelName, token, uid. Use these in AgoraRTC.createClient() on the frontend.\n\nResponse:\n```json\n{\n  \"appId\": \"abc123\",\n  \"channelName\": \"64f3a...\",\n  \"token\": \"007eJxT...\",\n  \"uid\": 1234567890,\n  \"expiresIn\": 3600\n}\n```"
          }
        },
        {
          "name": "Get Token \u2014 Patient gets Agora token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  console.log('Patient token:', res.token);",
                  "  console.log('Patient UID:', res.uid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/token/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "token",
                "{{appointmentId}}"
              ]
            },
            "description": "Patient (or doctor) fetches their RTC token. Call this just before joining the Agora channel. Tokens expire after AGORA_TOKEN_EXPIRY seconds \u2014 call again to refresh."
          }
        },
        {
          "name": "Get Token \u2014 Doctor refreshes Agora token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/token/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "token",
                "{{appointmentId}}"
              ]
            }
          }
        },
        {
          "name": "Get Session Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/status/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "status",
                "{{appointmentId}}"
              ]
            },
            "description": "Poll this to know if the doctor has started the session yet. isActive=true means the channel is live."
          }
        },
        {
          "name": "End Session \u2014 Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorNotes\": \"Patient in stable condition. Prescribed medication. Follow-up in 4 weeks.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/end/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "end",
                "{{appointmentId}}"
              ]
            },
            "description": "Doctor ends the session. Sets appointment status to 'completed' and records duration."
          }
        }
      ]
    },
