# Environment files and sensitive data
*.env
*.env.*
*.key
*.pem
*.p12
*.crt
*.cert
secrets.json
config.local.*
*.local

# Secret YAML files - never commit actual secrets to repo
*-secret.yaml
*-secret.yml

# API keys and credentials
api-keys.*
credentials.*
auth.*

# Database files
*.db
*.sqlite
*.sqlite3

# Log files
*.log
logs/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
out/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Kubernetes manifests
k8s/

# Docker files (except .dockerignore)
Dockerfile*
docker-compose*.yml

# Temporary files
tmp/
temp/
*.tmp
